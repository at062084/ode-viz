#!/bin/bash

# This file is sourced by the run_*.sh shell scripts that are invoked by airflow
# It establishes the *_ROOT_DIRs for location of subsequent entitities
# Next, laguage specific inventory.<lang> files are read by the ETL scripts writte in py,R,sh

# CAVEAT: 
# These root directories may be relocated:
# For local development the  *_ROOT_DIR variables MUST point to local folders before calling this script!!!

# Global flags
bDebug=FALSE

#-----------------------------------------------------------------------------------
# Prepare standard environment
#-----------------------------------------------------------------------------------

[ -z "$INVENTORY_ROOT_DIR" ] && export INVENTORY_ROOT_DIR=/export/inventory
[ -z "$DATA_ROOT_DIR" ]      && export DATA_ROOT_DIR=/export/data
[ -z "$LOG_ROOT_DIR" ]       && export LOG_ROOT_DIR=/export/log
[ -z "$VAULT_ROOT_DIR" ]     && export VAULT_ROOT_DIR=/export/vault
[ -z "$PROJECT_ROOT_DIR" ]   && export PROJECT_ROOT_DIR=/export/project
[ -z "$VENV_ROOT_DIR" ]      && export VENV_ROOT_DIR=/opt/venv/python-3.12
[ -z "$PYTHONPATH" ]         && export PYTHONPATH=/export


# First thing to do is setup a logfile
export ODE_AIRFLOW_LOG="$LOG_ROOT_DIR/ode/ode.flow.log"
export AIR_AIRFLOW_LOG="$LOG_ROOT_DIR/airflow/air.flow.log"

# Then read shell functions, in particular the logging function logMsg
if [ ! -r $INVENTORY_ROOT_DIR/scripts/utils.sh ]
then
    echo "ERROR: Cannot read $INVENTORY_ROOT_DIR/scripts/utils.sh"
    exit 1
fi
source $INVENTORY_ROOT_DIR/scripts/utils.sh

